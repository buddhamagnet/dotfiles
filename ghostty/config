theme = Catppuccin Mocha
font-family = JetBrains Mono
font-size = 19
background-opacity = 0.7
background-blur-radius = 20

# Keybindings for terminal scrollback
# Map Page Up/Down to scroll actions instead of passing to shell
keybind = page_up=scroll_page_up
keybind = page_down=scroll_page_down
keybind = home=scroll_to_top
keybind = end=scroll_to_bottom

# macOS-style scroll shortcuts
keybind = super+home=scroll_to_top
keybind = super+end=scroll_to_bottom

# Split and window management
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface
keybind = super+shift+w=close_all_windows

# Navigate between splits
keybind = super+left=goto_split:left
keybind = super+right=goto_split:right
keybind = super+up=goto_split:top
keybind = super+down=goto_split:bottom
